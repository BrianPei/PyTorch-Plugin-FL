{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagos.ai/flagcicd/project.schema.json",
  "title": "Project adapter contract",
  "description": "The repository-side half of the FlagCICD contract. The core reads only these fields; everything a single repository decides for itself lives behind the adapter paths.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "entry_workflow",
    "platform_config_glob",
    "adapter",
    "checks",
    "levels",
    "risk_rules",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "flagcicd.project/v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "entry_workflow": {
      "type": "string",
      "pattern": "^\\.github/workflows/[^/]+\\.yml$"
    },
    "platform_config_glob": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "description": "Files that make this repository an adapter. The core never hardcodes their names.",
      "required": ["tiers", "environment", "acceptance", "inventory", "manifest"],
      "additionalProperties": false,
      "properties": {
        "tiers": {"type": "string"},
        "environment": {"type": "string"},
        "acceptance": {"type": "string"},
        "inventory": {"type": "string"},
        "manifest": {"type": "string"}
      }
    },
    "checks": {
      "type": "object",
      "description": "Every gate the entry workflow can run. Level lists are matched against the plan's test_level.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["workflow", "job", "entry_job", "levels"],
        "additionalProperties": false,
        "properties": {
          "workflow": {
            "type": "string",
            "pattern": "^\\.github/workflows/[^/]+\\.yml$"
          },
          "job": {"type": "string", "minLength": 1},
          "entry_job": {
            "type": "string",
            "minLength": 1,
            "description": "Job name in the entry workflow's run summary."
          },
          "levels": {
            "type": "array",
            "items": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {"type": "string"}
        }
      }
    },
    "levels": {
      "type": "object",
      "required": ["L0", "L1", "L2", "L3", "L4"],
      "additionalProperties": false,
      "properties": {
        "L0": {"$ref": "#/$defs/level"},
        "L1": {"$ref": "#/$defs/level"},
        "L2": {"$ref": "#/$defs/level"},
        "L3": {"$ref": "#/$defs/level"},
        "L4": {"$ref": "#/$defs/level"}
      }
    },
    "risk_rules": {
      "type": "object",
      "required": [
        "version",
        "no_diff_level",
        "rules",
        "unknown_level",
        "unknown_risk"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string"},
        "no_diff_level": {"$ref": "#/$defs/level_name"},
        "unknown_level": {"$ref": "#/$defs/level_name"},
        "unknown_risk": {"type": "string", "pattern": "^R[0-9]+$"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "paths", "minimum_level", "risk"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1
              },
              "minimum_level": {"$ref": "#/$defs/level_name"},
              "risk": {"type": "string", "pattern": "^R[0-9]+$"}
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["schema_version", "summary_artifact", "raw_formats"],
      "additionalProperties": true,
      "properties": {
        "schema_version": {"type": "string"},
        "summary_artifact": {"type": "string"},
        "raw_formats": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "level_name": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4"]
    },
    "level": {
      "type": "object",
      "required": ["support", "scope", "checks"],
      "additionalProperties": false,
      "properties": {
        "support": {"type": "string", "enum": ["supported", "unsupported"]},
        "readiness": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "entry_workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.yml$"
        },
        "checks": {
          "type": "array",
          "comment": "Check ids from the top-level catalog, not free text.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
